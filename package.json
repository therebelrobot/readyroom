{
  "name": "readyroom",
  "version": "0.1.7",
  "description": "An MCP server that lets coding agents request a human decision without hijacking whichever window is focused. Agents enqueue a ticket; the human drains the queue from one page when they choose to.",
  "type": "module",
  "keywords": [
    "mcp",
    "mcp-server",
    "approval",
    "agents",
    "claude-code",
    "self-hosted",
    "human-in-the-loop"
  ],
  "bin": {
    "readyroom": "dist/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therebelrobot/readyroom.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Unlicense",
  "scripts": {
    "dev": "tsx watch --import ./scripts/html-loader-register.mjs src/index.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --banner:js='#!/usr/bin/env node' --loader:.html=text --outfile=dist/server.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./scripts/html-loader-register.mjs --import tsx --test test/*.test.ts test/core/*.test.ts test/storage/*.test.ts",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "docker:build": "docker build -t ghcr.io/therebelrobot/readyroom:local .",
    "docker:run": "docker run --rm -d -p 127.0.0.1:8971:8971 -v $(pwd)/.state:/app/.state --env-file .env ghcr.io/therebelrobot/readyroom:local",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/readyroom:latest --push .",
    "release:patch": "npm version patch -m \"chore: release v%s\" && git push && git push --tags",
    "release:minor": "npm version minor -m \"chore: release v%s\" && git push && git push --tags",
    "release:major": "npm version major -m \"chore: release v%s\" && git push && git push --tags",
    "release:tags": "git tag --sort=-v:refname | grep '^v'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}